{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openmindednewby/sign-in-config/blob/main/schema/sign-in-config.schema.json",
  "title": "Sign-in page configuration",
  "description": "Features, field validation, theme tokens, logo motion and copy for a sign-in page; the same file drives the server page and the app form.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "theme",
    "copy"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "features": {
      "$ref": "#/$defs/features"
    },
    "validation": {
      "$ref": "#/$defs/validation"
    },
    "theme": {
      "$ref": "#/$defs/theme"
    },
    "motion": {
      "$ref": "#/$defs/motion"
    },
    "copy": {
      "$ref": "#/$defs/copy"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "features"
        ],
        "properties": {
          "features": {
            "required": [
              "rememberMe"
            ],
            "properties": {
              "rememberMe": {
                "required": [
                  "enabled"
                ],
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "copy": {
            "required": [
              "rememberMeLabel"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "features"
        ],
        "properties": {
          "features": {
            "required": [
              "forgotPassword"
            ],
            "properties": {
              "forgotPassword": {
                "required": [
                  "enabled"
                ],
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "copy": {
            "required": [
              "forgotPasswordLink",
              "forgotPasswordTitle",
              "forgotPasswordSubmit",
              "forgotPasswordSent",
              "resetPasswordTitle",
              "resetPasswordSubmit",
              "resetPasswordDone",
              "resetPasswordInvalid"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "features"
        ],
        "properties": {
          "features": {
            "required": [
              "signUp"
            ],
            "properties": {
              "signUp": {
                "required": [
                  "enabled"
                ],
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "copy": {
            "required": [
              "signUpLink"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "features"
        ],
        "properties": {
          "features": {
            "required": [
              "demoAccounts"
            ],
            "properties": {
              "demoAccounts": {
                "required": [
                  "enabled"
                ],
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "copy": {
            "required": [
              "demoToggle",
              "demoHint",
              "demoAriaLabel",
              "demoRowAriaLabel"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "validation"
        ],
        "properties": {
          "validation": {
            "required": [
              "username"
            ],
            "properties": {
              "username": {
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "email"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "copy": {
            "required": [
              "emailInvalidMessage"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|rgba?\\( *[0-9]{1,3} *, *[0-9]{1,3} *, *[0-9]{1,3} *(, *(0|1|0?\\.[0-9]+) *)?\\))$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rememberMe": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "maxHours"
            ]
          },
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxHours": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 2160
            }
          }
        },
        "forgotPassword": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "tokenMinutes": {
              "type": "integer",
              "minimum": 5,
              "maximum": 1440
            }
          }
        },
        "signUp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "href"
            ]
          },
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "href": {
              "type": "string",
              "maxLength": 2048,
              "pattern": "^(/|https://)[^\\s\"'<>]*$"
            }
          }
        },
        "demoAccounts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "fieldRule": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": {
        "pattern": [
          "patternMessage"
        ]
      },
      "properties": {
        "required": {
          "type": "boolean"
        },
        "minLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "pattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "patternMessage": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "usernameRule": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": {
        "pattern": [
          "patternMessage"
        ]
      },
      "properties": {
        "kind": {
          "enum": [
            "email",
            "text"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "minLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "pattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "patternMessage": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "username": {
          "$ref": "#/$defs/usernameRule"
        },
        "password": {
          "$ref": "#/$defs/fieldRule"
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "colors",
        "fontFamily"
      ],
      "properties": {
        "colors": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "brand",
            "brandHover",
            "brandInk",
            "brandOnLight",
            "band",
            "ink",
            "label",
            "line",
            "muted",
            "card",
            "pageTop",
            "pageBottom",
            "shadow",
            "focusRing",
            "errorBackground",
            "errorBorder",
            "errorText",
            "rowBackground",
            "rowHover",
            "success"
          ],
          "properties": {
            "brand": {
              "$ref": "#/$defs/color"
            },
            "brandHover": {
              "$ref": "#/$defs/color"
            },
            "brandInk": {
              "$ref": "#/$defs/color"
            },
            "brandOnLight": {
              "$ref": "#/$defs/color"
            },
            "band": {
              "$ref": "#/$defs/color"
            },
            "ink": {
              "$ref": "#/$defs/color"
            },
            "label": {
              "$ref": "#/$defs/color"
            },
            "line": {
              "$ref": "#/$defs/color"
            },
            "muted": {
              "$ref": "#/$defs/color"
            },
            "card": {
              "$ref": "#/$defs/color"
            },
            "pageTop": {
              "$ref": "#/$defs/color"
            },
            "pageBottom": {
              "$ref": "#/$defs/color"
            },
            "shadow": {
              "$ref": "#/$defs/color"
            },
            "focusRing": {
              "$ref": "#/$defs/color"
            },
            "errorBackground": {
              "$ref": "#/$defs/color"
            },
            "errorBorder": {
              "$ref": "#/$defs/color"
            },
            "errorText": {
              "$ref": "#/$defs/color"
            },
            "rowBackground": {
              "$ref": "#/$defs/color"
            },
            "rowHover": {
              "$ref": "#/$defs/color"
            },
            "success": {
              "$ref": "#/$defs/color"
            }
          }
        },
        "fontFamily": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9 ,'\"._-]+$"
        },
        "radii": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "input": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            "card": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            }
          }
        },
        "spacing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "xs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 128
            },
            "sm": {
              "type": "integer",
              "minimum": 0,
              "maximum": 128
            },
            "md": {
              "type": "integer",
              "minimum": 0,
              "maximum": 128
            },
            "lg": {
              "type": "integer",
              "minimum": 0,
              "maximum": 128
            },
            "xl": {
              "type": "integer",
              "minimum": 0,
              "maximum": 128
            }
          }
        },
        "typography": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "integer",
              "minimum": 8,
              "maximum": 96
            },
            "subtitle": {
              "type": "integer",
              "minimum": 8,
              "maximum": 96
            },
            "label": {
              "type": "integer",
              "minimum": 8,
              "maximum": 96
            },
            "body": {
              "type": "integer",
              "minimum": 8,
              "maximum": 96
            },
            "caption": {
              "type": "integer",
              "minimum": 8,
              "maximum": 96
            }
          }
        }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "intro": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "preset"
          ],
          "properties": {
            "preset": {
              "enum": [
                "draw",
                "flood",
                "stagger-rise",
                "scale-pop",
                "orbit",
                "wipe",
                "morph-from-circle",
                "sweep",
                "pulse",
                "fly-in",
                "spin-assemble",
                "drop-bounce",
                "flip",
                "slam-shake"
              ]
            },
            "durationMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1200
            }
          }
        },
        "micro": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "preset"
          ],
          "properties": {
            "preset": {
              "enum": [
                "spread",
                "pulse",
                "sweep"
              ]
            },
            "durationMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 300
            }
          }
        },
        "idle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "recipe"
          ],
          "properties": {
            "recipe": {
              "enum": [
                "rim-glint",
                "faces-part",
                "breath",
                "orbit-spark"
              ]
            },
            "durationMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 600
            }
          }
        }
      }
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "usernameLabel",
        "passwordLabel",
        "submitLabel",
        "requiredMessage",
        "tooShortMessage",
        "tooLongMessage"
      ],
      "properties": {
        "usernameLabel": {
          "$ref": "#/$defs/text"
        },
        "passwordLabel": {
          "$ref": "#/$defs/text"
        },
        "submitLabel": {
          "$ref": "#/$defs/text"
        },
        "requiredMessage": {
          "$ref": "#/$defs/text"
        },
        "tooShortMessage": {
          "$ref": "#/$defs/text"
        },
        "tooLongMessage": {
          "$ref": "#/$defs/text"
        },
        "footer": {
          "$ref": "#/$defs/text"
        },
        "emailInvalidMessage": {
          "$ref": "#/$defs/text"
        },
        "rememberMeLabel": {
          "$ref": "#/$defs/text"
        },
        "forgotPasswordLink": {
          "$ref": "#/$defs/text"
        },
        "forgotPasswordTitle": {
          "$ref": "#/$defs/text"
        },
        "forgotPasswordSubmit": {
          "$ref": "#/$defs/text"
        },
        "forgotPasswordSent": {
          "$ref": "#/$defs/text"
        },
        "resetPasswordTitle": {
          "$ref": "#/$defs/text"
        },
        "resetPasswordSubmit": {
          "$ref": "#/$defs/text"
        },
        "resetPasswordDone": {
          "$ref": "#/$defs/text"
        },
        "resetPasswordInvalid": {
          "$ref": "#/$defs/text"
        },
        "signUpLink": {
          "$ref": "#/$defs/text"
        },
        "demoToggle": {
          "$ref": "#/$defs/text"
        },
        "demoHint": {
          "$ref": "#/$defs/text"
        },
        "demoAriaLabel": {
          "$ref": "#/$defs/text"
        },
        "demoRowAriaLabel": {
          "$ref": "#/$defs/text"
        }
      }
    }
  }
}
